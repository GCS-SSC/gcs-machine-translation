{
  "compilerOptions": {
    "target": "ES2019", "lib": ["DOM", "ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["client/**/*.ts", "components/**/*.vue", "shared/**/*.ts", "server/**/*.ts", "i18n/**/*.ts", "extension.config.ts", "tests/**/*.ts"]
}
